# Shared secret for POST /api/v1/* (Authorization: Bearer … or x-api-key)
PAL_API_KEY=replace-me-with-a-long-random-string

# Upstash Redis (recommended on Vercel for cross-instance rate limits)
# Create a free DB at https://upstash.com and paste REST credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: comma-separated browser origins. Default is *.
# PAL_CORS_ORIGINS=https://pal-trait-calculator.vercel.app,http://localhost:5173
