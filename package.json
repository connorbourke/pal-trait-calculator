{
  "name": "pal-trait-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/normalize-data.mjs",
    "data:fetch": "bash scripts/fetch-data.sh",
    "build:api": "node scripts/build-api.mjs",
    "dev": "npm run build:api && vite",
    "build": "npm run data && tsc --noEmit && npm run build:api && vite build",
    "preview": "vite preview",
    "favicon": "node scripts/quantize-favicon.mjs",
    "smoke:api": "bash scripts/smoke-api.sh"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "@vercel/node": "^5.9.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
